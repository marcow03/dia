<mxfile host="dia">
  <diagram id="dia" name="Page-1">
    <mxGraphModel grid="1" gridSize="10" math="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="Start" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#e3f2fd;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="\(x^2 + y^2\)" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="0" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="ok?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#1e88e5;fillColor=none;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="note" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="120" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="\(\alpha\)" style="html=1;rounded=0;endArrow=classic;startArrow=none;labelBackgroundColor=#ffffff;strokeColor=#000000;fillColor=none;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="" style="html=1;rounded=0;endArrow=classic;startArrow=classic;strokeColor=#000000;fillColor=none;dashed=1;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="30"/>
              <mxPoint x="340" y="150"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="" style="html=1;rounded=0;endArrow=none;startArrow=none;curved=1;strokeColor=#000000;fillColor=none;" edge="1" parent="1" target="n3">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="240" as="sourcePoint"/>
            <Array as="points">
              <mxPoint x="80" y="200"/>
              <mxPoint x="160" y="280"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
